# Copy this file to `.env` and fill in real values before running docker-compose or the API directly.
# Never commit the actual `.env` file.
#
# This file covers TWO different compose stacks with different variable-naming conventions:
#   - root docker-compose.yml (local dev): reads the double-underscore `Section__Key` names
#     below directly (Jwt__Key/Cors__Origins__0 are hardcoded dev-only values in that file
#     itself and NOT read from .env -- only the AI__* section is).
#   - docker/production/docker-compose.prod.yml: reads the plain UPPER_CASE names in the
#     "Production compose" section further down and maps them to Section__Key itself.
#   Using the wrong section for the stack you're running leaves the other stack's variables
#   unset -- for the prod stack that means Program.cs's Production-only startup check (added
#   for todo-phase-7-hardening.md) will refuse to boot rather than silently run with an empty
#   JWT key or CORS origin.

# ── PostgreSQL (used by both stacks) ──
POSTGRES_DB=aihelpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=change-me
ConnectionStrings__DefaultConnection=Host=postgres;Database=aihelpdesk;Username=helpdesk;Password=change-me

# ── File Uploads (used by both stacks) ──
Uploads__Path=/app/uploads

# ── Local dev only (root docker-compose.yml) ──
AI__Endpoint=https://api.openai.com/v1/
AI__ApiKey=
AI__ChatModel=gpt-4o-mini
AI__EmbeddingModel=text-embedding-3-small
AI__RateLimit__MaxRequestsPerMinute=30
AI__RateLimit__Enabled=true
AI__Budget__DailyTokenBudget=1000000
AI__Budget__EnforceBudget=false
ASPNETCORE_ENVIRONMENT=Development

# ── Production compose only (docker/production/docker-compose.prod.yml) ──
# Generate JWT_KEY with: openssl rand -base64 64
JWT_KEY=change-me-to-a-random-64-plus-character-secret
JWT_ISSUER=AIHelpdesk
JWT_AUDIENCE=AIHelpdesk
# Public HTTPS origin of the deployed frontend, e.g. https://helpdesk.example.com -- must not
# be "*" or a localhost/127.0.0.1 address, both are rejected at startup in Production.
FRONTEND_ORIGIN=https://your-domain.example.com
AI_API_KEY=
AI_ENDPOINT=https://api.openai.com/v1/
