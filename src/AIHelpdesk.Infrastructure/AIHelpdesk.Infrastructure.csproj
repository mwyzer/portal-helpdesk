<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AIHelpdesk.Application\AIHelpdesk.Application.csproj" />
    <ProjectReference Include="..\AIHelpdesk.Domain\AIHelpdesk.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="Mapster" Version="10.*" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.*" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <PackageReference Include="PdfSharpCore" Version="1.3.65" />
    <!-- PdfSharpCore 1.3.65 transitively pulls SixLabors.ImageSharp 1.0.4, which has multiple
         High/Moderate advisories per the NuGet vulnerability scan (2026-08-08). Direct
         reference here forces NuGet to resolve the patched version instead. Safe: LetterDocumentGenerator
         only emits text based PDFs, no image embedding, so this only touches PdfSharpCore's
         internal usage, exercised by the existing DocumentService tests. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AIHelpdesk.Tests" />
  </ItemGroup>

</Project>
